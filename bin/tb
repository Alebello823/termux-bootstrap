#!/data/data/com.termux/files/usr/bin/bash

BASE_DIR="$HOME/termux-bootstrap"

source "$BASE_DIR/lib/system.sh"
source "$BASE_DIR/lib/repair.sh"
source "$BASE_DIR/lib/verify.sh"

case "$1" in

doctor)

echo "================================"
echo " TERMUX BOOTSTRAP DOCTOR"
echo "================================"

bash "$BASE_DIR/core/doctor/report.sh"

echo

bash "$BASE_DIR/core/doctor/summary.sh"

echo
echo "Report:"
echo "$BASE_DIR/reports/system_report.txt"

;;

repair)

repair_termux

;;

backup)

source "$BASE_DIR/lib/backup.sh"

backup_termux

;;
verify)

verify_installation

;;

update)

source "$BASE_DIR/lib/update.sh"

update_system

;;

install)

bash "$BASE_DIR/install.sh"

bash "$BASE_DIR/core/version.sh"

;;

security)

bash "$BASE_DIR/core/security/report.sh"

echo

cat "$BASE_DIR/reports/security_report.txt"

;;

version)

bash "$BASE_DIR/core/version.sh"

;;

*)

echo "Uso:"
echo
echo "tb doctor   - Diagnóstico del sistema"
echo "tb repair   - Reparar Termux"
echo "tb verify   - Verificar herramientas"
echo "tb update   - Actualizar herramientas"
echo "tb install  - Ejecutar instalación"
echo "tb version  - Mostrar versión"

;;

esac
